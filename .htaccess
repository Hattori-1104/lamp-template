# ディレクトリ一覧を表示しない
Options -Indexes

# ---------------------------------------------
# HTTP → HTTPS リダイレクト
# 開発環境（APP_ENV=dev）ではリダイレクトしない
# ---------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{ENV:APP_ENV} !^dev$
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------
# 公開しないパス
# ---------------------------------------------
# ドットファイル・ドットフォルダー（.git, .env, .devcontainer.json など）
# Let's Encrypt などで使う .well-known は除外
RedirectMatch 404 /\.(?!well-known/)

# 内部用ディレクトリ
RedirectMatch 404 ^/_private(/|$)
RedirectMatch 404 \.code-workspace$

# パッケージマネージャーのファイル（ライブラリの中身・バージョン情報）
RedirectMatch 404 ^/(vendor|node_modules)(/|$)
RedirectMatch 404 /(composer\.(json|lock)|package(-lock)?\.json)$

# ---------------------------------------------
# セキュリティヘッダー
# ---------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>